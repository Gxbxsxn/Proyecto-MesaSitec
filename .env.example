# --- Backend (.NET) ---
# Secreto usado para firmar los JWT (HS256). Cambialo en un entorno real.
JWT_SECRET=una-clave-secreta-de-desarrollo-de-al-menos-32-caracteres
# Cadena de conexion de SQLite (archivo local).
CONNECTION_STRING=Data Source=mesasitec.db
# Origen permitido por CORS para el frontend.
FRONTEND_ORIGIN=http://localhost:5173
# Fecha base para generar los datos semilla de forma determinista.
SEED_FECHA_BASE=2026-01-15T08:00:00Z

# --- Frontend (Vite) ---
# URL base de la API que consume el frontend.
VITE_API_URL=http://localhost:5080/api/v1
